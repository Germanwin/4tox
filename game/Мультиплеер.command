#!/bin/bash
# Двойной клик: сервер мультиплеера 4tox + HTTPS-ссылка для друзей.
# Прямой IP из дома часто не работает: провайдер держит за CGNAT (сервер сам
# скажет это в окне). Туннель pinggy обходит CGNAT и даёт HTTPS; cloudflared
# не используется — он буферизует события лобби.
# Окно терминала должно остаться открытым — в нём живёт мир хоста.
cd "$(dirname "$0")/.." || exit 1
exec node game/server/server.js --tunnel --open
