[Unit]
Description=4tox room coordinator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=4tox
Group=4tox
WorkingDirectory=/opt/4tox
ExecStart=/opt/node/bin/node /opt/4tox/game/server/coordinator.js
Environment=COORDINATOR_STATE=/var/lib/4tox-coordinator/state.enc
Environment=COORDINATOR_PORT=8798
Environment=COORDINATOR_TRUST_LOOPBACK_PROXY=1
Environment=COORDINATOR_CLIENT_CONFIG=/etc/4tox/eos-client.json
LoadCredential=coordinator-key:/etc/4tox/coordinator.key
StateDirectory=4tox-coordinator
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
