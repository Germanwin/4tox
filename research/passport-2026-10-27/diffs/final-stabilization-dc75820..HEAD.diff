+}
+check(P.buildings().length <= 60, 'ожиданий не больше лимита: ' + P.buildings().length);
+check(P.exportState().actions.length <= 60, 'выгрузка тоже ограничена');
+check(P.exportState().history.length <= 120, 'след диагностики ограничен');
