extends SceneTree
const Client = preload("res://scripts/eos/coordinator_client.gd")
func _init() -> void:
	_run()
func _run() -> void:
	await process_frame
	var host = Client.new()
	var guest = Client.new()
	root.add_child(host)
	root.add_child(guest)
	assert(not host.configure("http://example.com"))
	assert(host.configure(OS.get_cmdline_user_args()[0], true))
	assert(guest.configure(OS.get_cmdline_user_args()[0], true))
	var made: Dictionary = await host.create_room("Host", 2, "v1", "host.socket")
	assert(made.get("ok", false))
	var joined: Dictionary = await guest.join_room(host.code, "Guest", "v1")
	assert(joined.get("ok", false))
	assert(not guest.state.has("token"))
	assert((await guest.request("bind", {"playerId": 1, "roomTokenHash": "local-token".sha256_text()})).get("ok", false))
	var snapshot := JSON.stringify({"lobby": {"players": [{"id": 1, "token": "local-token"}]}})
	assert((await host.request("backup", {"data": Marshalls.utf8_to_base64(snapshot), "sha256": snapshot.sha256_text()})).get("ok", false))
	await host.leave()
	var heartbeat: Dictionary = await guest.request("heartbeat", {})
	assert(heartbeat.get("candidate", false))
	assert((await guest.request("restore", {})).get("ok", false))
	var active: Dictionary = await guest.request("activate", {"address": "new.socket"})
	assert(active.get("ok", false) and active.get("host", false))
	await guest.leave()
	host.queue_free()
	guest.queue_free()
	print("PASS coordinator client: create, join, election, activate and leave")
	quit(0)
