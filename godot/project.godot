; Engine configuration file.
; 4tox — Godot port. See README.md.

config_version=5

[application]

config/name="4tox"
config/description="Изометрическая деревня 4tox, перенесённая на Godot 4."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
run/max_fps=60

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0

[rendering]

renderer/rendering_method="gl_compatibility"
; macOS Universal/Arm64 требует ETC2 ASTC при экспорте (см. tools/package.sh).
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.078431, 0.301961, 0.501961, 1)

