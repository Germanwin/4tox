# Мусор, который не должен попадать в историю.
# Правила раскладки проекта — docs/STRUCTURE.md

# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# Blender: автосохранение рядом с .blend
*.blend1

# Ручные резервные копии правок (имя.py.bak, имя_v1.py.bak)
*.bak

# Кадры браузерных приёмок игры: 57 МБ, перерисовываются прогоном
# node mapgen2/tools/place.js и соседних скриптов
mapgen2/tools/out/

# То же для приёмок игры: node game/tools/menu.js
game/tools/out/

# То же для приёмки стенда моделей: node art/tools/model-stand/tools/shot.js
# (отобранные кадры для README лежат рядом — art/tools/model-stand/show/)
art/tools/model-stand/tools/out/

# Состояние серверных комнат: журнал, checkpoint, lobby.json (секреты токенов)
game/server/var/
